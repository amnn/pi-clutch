{
  "name": "pi-clutch",
  "version": "0.1.1",
  "description": "A Pi extension that toggles between exploratory and edit-enabled modes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amnn/pi-clutch.git"
  },
  "homepage": "https://github.com/amnn/pi-clutch#readme",
  "bugs": {
    "url": "https://github.com/amnn/pi-clutch/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent"
  ],
  "files": [
    "index.ts",
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
