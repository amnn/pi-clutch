{
  "name": "pi-clutch",
  "version": "0.1.2",
  "description": "Lightweight plan mode for the Pi coding agent — toggle between read-only exploration and edit-enabled operation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amnn/pi-clutch.git"
  },
  "homepage": "https://github.com/amnn/pi-clutch#readme",
  "bugs": {
    "url": "https://github.com/amnn/pi-clutch/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi package",
    "pi-extension",
    "pi extension",
    "pi",
    "pi-coding-agent",
    "pi coding agent",
    "plan-mode",
    "plan mode",
    "planning mode",
    "read-only",
    "coding-agent",
    "coding agent",
    "ai coding agent"
  ],
  "license": "Apache-2.0",
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "smoke": "pi --offline --no-extensions -e . --list-models __pi_package_smoke__",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm test && pnpm run smoke && pnpm audit",
    "bump:patch": "pnpm version patch --no-git-tag-version --message \"chore(release): v%s\"",
    "bump:minor": "pnpm version minor --no-git-tag-version --message \"chore(release): v%s\"",
    "bump:major": "pnpm version major --no-git-tag-version --message \"chore(release): v%s\"",
    "prepublishOnly": "pnpm check"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "^24.0.0",
    "prettier": "3.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.20.0"
}
